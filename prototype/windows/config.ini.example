# SecDisplay Windows 端配置文件（支持副屏接收端与主控发送端双角色）。
# 放在 SecDisplayReceiver.exe 同目录，文件名 config.ini。
# 命令行参数优先级高于本文件，临时覆盖不用改这里。

# Mac 的 IPv4 字面量地址（接收模式与 9923 中转均要求 IPv4，如 10.10.10.1）
host=10.10.10.1
port=9922

# ---- 角色与显示方式 ----
# receiver = Windows 当副屏（默认，Mac 主屏 -> Windows）
# sender   = Mac 当 Windows 副屏（Windows 主控 -> Mac）
mode=receiver
# 主控发送时的画面来源（mode=sender 时生效）：
# extend = 扩展屏幕（独立虚拟副屏，需安装 Parsec Virtual Display Adapter）
# mirror = 镜像主屏（同步 Windows 物理主屏，无需虚拟屏驱动）
displaymode=extend
# 启动时是否自动显示控制面板（1=显示，0=后台启动；命令行 --no-panel 可临时覆盖）
showpanel=1

# ---- 副屏接收端参数（mode=receiver 时生效）----
# 初始窗口尺寸；连接后会自动跟随 Mac 会话头调整
width=2880
height=1800
# 可选坐标基准覆盖（一般无需填写，保持注释即可）
# coordw=1440
# coordh=900
# 1=全屏，0=窗口
fullscreen=0
# 1=垂直同步（均匀），0=免同步（低延迟）
vsync=1
# 抖动缓冲，默认关
pace=0
# 0x07 健康度回传，默认关
feedback=0
# 晃动鼠标找光标，默认开
shake=1
# 投屏期间保持屏幕常亮，默认开
keepon=1
# Windows 本机鼠标在副屏窗口内可直接操控 macOS，默认开
mousebridge=1
# Mac 切换主屏/副屏后，Windows 自动跟随互补角色（Mac 为角色基准），默认开
autofollow=1

# ---- 主控发送端参数（mode=sender 时生效）----
# 虚拟扩展屏分辨率（需先安装 Parsec Virtual Display Adapter）、帧率上限 (24~144)、目标码率 (10~200 Mbps) 与 DPI
hostwidth=2880
hostheight=1800
fps=60
bitrate=50
# 虚拟屏 DPI 缩放百分比（0=跟随系统推荐，可选 100~300）
hostdpi=0

# 日志文件，相对路径按进程工作目录
log=logs\receiver.log
